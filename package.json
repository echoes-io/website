{
  "name": "@echoes-io/website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "concurrently -n format,types,lockfile npm:lint:format npm:lint:typecheck npm:lint:lockfile",
    "lint:format": "biome check --write .",
    "lint:typecheck": "tsc --noEmit",
    "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@echoes-io/brand": "^2.0.1",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "9.1.2",
    "lefthook": "1.11.13",
    "lockfile-lint": "4.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
